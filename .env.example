# DB の root パスワード(MySQL の SA_PASSWORD として使う)
SA_PASSWORD=YourStrong!Passw0rd

# AWS リージョン(Nova Lite は us-east-1 / us-west-2 / us-east-2 で利用可能)
AWS_REGION=us-east-1

# Bedrock のモデル ID
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Bedrock の API キー(Bearer 認証)
# Strands Agents(Python) は BEDROCK_API_KEY を直接サポートしないため、
# app/main.py 起動時に AWS_BEARER_TOKEN_BEDROCK に自動コピーされる。
BEDROCK_API_KEY=bedrock-api-key-xxxxxxxxxxxxxxxxxxxxxxx
